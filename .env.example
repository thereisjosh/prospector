# Prospector — environment config. Copy to .env and fill in what you use. Never commit .env.
#   cp .env.example .env
# Every name the code reads is listed. Empty = unset (the code's default applies). No real values here.

# --- Model and retrieval keys ---
# Anthropic key (console.anthropic.com/settings/keys): agent loop, planner, eval judges. Missing -> demo mode in the app.
ANTHROPIC_API_KEY=
# Exa key (dashboard.exa.ai): signal search, company lookups, page reads, contacts.
EXA_API_KEY=
# Exa API base URL (default https://api.exa.ai).
EXA_BASE_URL=
# Max concurrent Exa requests (default 4; Exa allows 10 req/s).
EXA_MAX_CONCURRENCY=
# Base delay in ms for Exa 429/5xx retries (default 500).
EXA_RETRY_BASE_MS=
# Directory to record Exa responses into (eval/run-agent.ts --record sets it).
EXA_RECORD_DIR=
# Directory to replay recorded Exa responses from instead of calling Exa.
EXA_REPLAY_DIR=

# --- Moonshot Kimi (optional; arm D, judge.ts --model kimi, calibrate-evidence-judge --model kimi; docs/RESEARCH-kimi.md) ---
# Moonshot key (platform.kimi.ai), sent as Authorization: Bearer to the Anthropic-compatible endpoint and the search API.
KIMI_API_KEY=
# Anthropic-compatible base URL (default https://api.moonshot.ai/anthropic); the search API uses the same origin.
KIMI_BASE_URL=

# --- TypeSafe AI Jev (optional; only the --model jev eval paths and src/judges/jev.ts) ---
# Jev key (console.typesafe.ai/keys).
JEV_API_KEY=
# Jev API base URL (default https://api.typesafe.ai).
JEV_BASE_URL=

# --- Langfuse (optional; tracing, prompts, datasets, online judges) ---
# Langfuse public key; tracing is on only when both keys are set.
LANGFUSE_PUBLIC_KEY=
# Langfuse secret key.
LANGFUSE_SECRET_KEY=
# Langfuse base URL (default https://cloud.langfuse.com).
LANGFUSE_BASE_URL=
# Older name for LANGFUSE_BASE_URL, read when that is unset.
LANGFUSE_HOST=
# Trace environment tag (eval runs default to "eval").
LANGFUSE_TRACING_ENVIRONMENT=
# Set to "off" to never fetch prompts from Langfuse (use the repo prompt).
LANGFUSE_PROMPTS=
# Langfuse prompt label to fetch (default production).
LANGFUSE_PROMPT_LABEL=
# When set, keep the SDK's default flush interval instead of flushing every span.
LANGFUSE_FLUSH_INTERVAL=

# --- App controls ---
# Token the /api/admin routes require.
ADMIN_TOKEN=
# HMAC secret that hashes workspace ids in traces (no hash without it).
TRACE_HMAC_SECRET=
# Routes return 503 once the day's Claude+Exa spend exceeds this many dollars; 0 = live runs off.
DAILY_SPEND_CAP_DOLLARS=
# Max concurrent live runs per visitor workspace (default 2).
VISITOR_MAX_LIVE_RUNS=
# Dollar allowance per visitor workspace (default 2.5).
VISITOR_MAX_DOLLARS=
# Daily dollar cap for the online lead judges (default 3; 0 = online judging off).
ONLINE_JUDGE_DAILY_CAP_DOLLARS=
# Assumed online-judge cost per lead for the cap (default 0.34).
ONLINE_JUDGE_COST_PER_LEAD_DOLLARS=
# Set to "off" to disable live runs (demo replay only).
LIVE_MODE=
# Set to 1 to replay recorded data; no keys needed.
DEMO_MODE=
# Same as DEMO_MODE=1, readable by the browser bundle.
NEXT_PUBLIC_DEMO=
# Directory of the demo recording (default ./eval/demo).
DEMO_DIR=
# Version /api/health reports when no platform commit SHA is set (default dev).
APP_VERSION=
# Public app URL; required by eval/online/worker.ts for the links it writes.
APP_URL=

# --- Storage ---
# Base data directory (default ".", or /tmp/prospector on Vercel).
DATA_DIR=
# Run state + events directory (default <DATA_DIR>/runs).
RUNS_DIR=
# Per-workspace memory directory (default <DATA_DIR>/workspaces).
WORKSPACES_DIR=

# --- Scripts only ---
# scripts/demo-gif.mjs: an already-running app URL to record instead of starting one.
BASE=
# scripts/demo-gif.mjs: extra directory to look for a Playwright install in.
PLAYWRIGHT_DIR=

# --- Set by the hosting platform or CI; do not set by hand ---
# VERCEL, VERCEL_GIT_COMMIT_SHA, RAILWAY_GIT_COMMIT_SHA, GITHUB_REPOSITORY
